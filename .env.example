# Copy this file to .env and fill in the values. .env is never committed.
# All EXPO_PUBLIC_ values end up inside the app, so only put PUBLIC keys here.

# Supabase → Project Settings → API (or the "Connect" button)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The "anon / public" key, or the newer "publishable" key (sb_publishable_...).
# NEVER the service_role / secret key.
EXPO_PUBLIC_SUPABASE_KEY=

# Cloudflare → Turnstile → your widget → Site key (the public one, not the secret)
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# For the iPhone app: one of the hostnames listed on your Turnstile widget,
# e.g. your Vercel address. Not needed for the website.
EXPO_PUBLIC_TURNSTILE_HOST=mydishdiary.vercel.app
